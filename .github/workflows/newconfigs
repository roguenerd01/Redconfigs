name: Combine V2Ray Configs from Telegram

on:
  schedule:
    - cron: '7/20 * * * *'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout this repository
        uses: actions/checkout@v5

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install requests beautifulsoup4

      - name: Scrape configs from Telegram channel
        run: |
          python - <<'PY'
          import re
          import requests
          from bs4 import BeautifulSoup

          # Public web preview of the channel
          url = "https://t.me/s/filembad"
          headers = {
              "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
          }

          resp = requests.get(url, headers=headers, timeout=30)
          resp.raise_for_status()

          soup = BeautifulSoup(resp.text, "html.parser")

          # Extract text from message bubbles
          messages = soup.select(".tgme_widget_message_text")
          text = "\n".join(m.get_text("\n", strip=True) for m in messages)

          # Find common proxy protocols (vless, vmess, trojan, ss)
          pattern = r'(?:vless|vmess|trojan|ss)://[^\s<>"\']+'
          configs = re.findall(pattern, text)

          # Remove duplicates while preserving order
          seen = set()
          unique_configs = []
          for c in configs:
              if c not in seen:
                  seen.add(c)
                  unique_configs.append(c)

          # Apply the same ID replacement as the original workflow
          output = "\n".join(unique_configs).replace(
              "@v2ray_configs_pool", "Redconfigs"
          )

          with open("Redconfigs.txt", "w", encoding="utf-8") as f:
              f.write(output + ("\n" if output else ""))

          print(f"Extracted {len(unique_configs)} unique configs.")
          PY

      - name: Commit and push Redconfigs.txt
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add Redconfigs.txt
          git commit -m "Update Redconfigs.txt [skip ci]" || echo "No changes to commit"
          git push
